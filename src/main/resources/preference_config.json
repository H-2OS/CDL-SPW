          "default_value": true
        },
        {
          "type": "list",
          "key": "animation.quality",
          "title": "动画质量",
          "summary": "决定**开启哪些动画效果**。标准 = 仅基础过渡；高 = 加歌词行退场；极致 = 再加频谱峰值保持。帧率由「动画帧率」单独设置。",
          "entries": [
            "标准（仅基础过渡）",
            "高（基础 + 歌词行退场）",
            "极致（全部 + 频谱峰值保持）"
          ],
          "entry_values": [
            "STANDARD",
            "HIGH",
            "ULTRA"
          ],
          "default_value": "HIGH"
        },
        {
          "type": "list",
          "key": "animation.frame_rate",
          "title": "动画帧率",
          "summary": "动画帧率上限。自动 = 跟随显示器刷新率（推荐）。各档取「不超过该值的最高可达帧率」（显示器刷新率的整数分之一），实际值可能低于档位数字、但绝不会超出；CPU 占用偏高时可降到 60。",
          "entries": [
            "自动（跟随显示器刷新率）",
            "不超过 60 Hz（最省电）",
            "不超过 90 Hz",
            "不超过 120 Hz",
            "不超过 144 Hz（最顺滑）"
          ],
          "entry_values": [
            "AUTO",
            "60",
            "90",
            "120",
            "144"
          ],
          "default_value": "AUTO"
        },
        {
          "type": "list",
          "key": "animation.style",
          "title": "动效风格（总开关）",
          "summary": "选具体风格 = **覆盖全部组件**（忽略各组件自己的设置）；选「各组件各自设置」= 总开关不干预，由「歌词动效风格」「播放控件动效风格」分别决定。",
          "entries": [
            "各组件各自设置（总开关不干预）",
            "淡入（覆盖全部组件）",
            "滑入（覆盖全部组件）",
            "弹出（覆盖全部组件）"
          ],
          "entry_values": [
