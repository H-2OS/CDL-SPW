{
  "configs": [
    {
      "title": "个性歌词",
      "config": "cdl.json",
      "preferences": [
        {
          "type": "list",
          "key": "layout.content_align",
          "title": "歌词对齐",
          "entries": [
            "左对齐",
            "居中",
            "右对齐"
          ],
          "entry_values": [
            "LEFT",
            "CENTER",
            "RIGHT"
          ],
          "default_value": "CENTER"
        },
        {
          "type": "list",
          "key": "layout.lines",
          "title": "歌词行数",
          "summary": "双行时第二行为副歌词，仍受「显示译文行」开关控制。",
          "entries": [
            "单行（仅主歌词）",
            "双行（主歌词 + 副歌词）"
          ],
          "entry_values": [
            "SINGLE",
            "DUAL"
          ],
          "default_value": "SINGLE"
        },
        {
          "type": "seekbar",
          "key": "layout.line_gap_px",
          "title": "歌词行间距",
          "default_value": 0,
          "min": 0,
          "max": 80
        },
        {
          "type": "list",
          "key": "main_lyric.karaoke.mode",
          "title": "歌词高亮方式",
          "summary": "三档互斥：整行高亮 / 平滑 / 逐字。有逐字时间轴时「逐字」档以时间轴为准。",
          "entries": [
            "不逐字（整行高亮）",
            "平滑高亮（已读色在字间移动）",
            "逐字高亮"
          ],
          "entry_values": [
            "LINE",
            "SMOOTH",
            "PER_CHAR"
          ],
          "default_value": "PER_CHAR"
        },
        {
          "type": "seekbar",
          "key": "lyric.offset_ms",
          "title": "歌词高亮偏移 ms",
          "default_value": 0,
          "min": -2000,
          "max": 2000
        },
        {
          "type": "list",
          "key": "lyric.animation_style",
          "title": "歌词动效风格",
          "summary": "歌词换行时**旧行**的退场方式（新行不受影响）。默认「跟随总开关」；选具体风格可让歌词单独一套，而总开关保持不动。",
          "entries": [
            "跟随总开关",
            "淡入",
            "滑入",
            "弹出"
          ],
          "entry_values": [
            "FOLLOW",
            "FADE",
            "SLIDE",
            "POP"
          ],
          "default_value": "FOLLOW"
        },
        {
          "type": "seekbar",
          "key": "main_lyric.letter_spacing_tenth_px",
          "title": "主歌词字间距（0.1 像素）",
          "summary": "同一行内字符之间的距离。0 = 不加（默认）；10 = 1.0 像素；上限 200 = 20.0 像素。字号越大，同样的像素字距看起来越紧。",
          "default_value": 0,
          "min": 0,
          "max": 200
        },
        {
          "type": "switch",
          "key": "translation.letter_spacing.follow_main",
          "title": "副歌词字间距跟随主歌词",
          "summary": "开启时副歌词按主歌词的字距按字号比例缩放（字越大间距越大）；关闭时副歌词不加字距。",
          "default_value": true
        },
