        {
          "type": "seekbar",
          "key": "main_lyric.font.size",
          "title": "字号",
          "default_value": 22,
          "min": 8,
          "max": 200
        },
        {
          "type": "list",
          "key": "main_lyric.font.weight",
          "title": "字体粗细",
          "summary": "常规 = 改动前的观感；加粗 = 用**该字体自己的粗体**（多字重字体会挑到真字重，单字重字体走算法合成）。",
          "entries": [
            "常规",
            "加粗"
          ],
          "entry_values": [
            "NORMAL",
            "BOLD"
          ],
          "default_value": "NORMAL"
        },
        {
          "type": "switch",
          "key": "layout.translation.enabled",
          "title": "显示翻译（副歌词）",
          "default_value": true
        },
        {
          "type": "seekbar",
          "key": "layout.translation.scale_percent",
          "title": "副歌词字号（%）",
          "summary": "副歌词相对主歌词的字号。100 = 标准（副歌词为主歌词的 64%）；越大副歌词越接近主歌词。",
          "default_value": 100,
          "min": 50,
          "max": 150
        },
        {
          "type": "list",
          "key": "layout.translation.position",
          "title": "副歌词位置",
          "summary": "仅在「歌词行数」为双行且开启了翻译时生效。",
          "entries": [
            "主歌词下方（默认）",
            "主歌词上方"
          ],
          "entry_values": [
            "BELOW",
            "ABOVE"
          ],
          "default_value": "BELOW"
        },
        {
          "type": "list",
          "key": "layout.noLyrics.mode",
          "title": "无歌词时的显示",
          "entries": [
            "隐藏歌词行",
            "显示占位文本",
            "隐藏整个词岛"
          ],
          "entry_values": [
            "HIDE_LINE",
            "PLACEHOLDER",
            "HIDE_ISLAND"
          ],
          "default_value": "PLACEHOLDER"
        },
        {
          "type": "switch",
          "key": "layout.noLyrics.showTrackTitle",
          "title": "无歌词时显示曲名与作者",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "layout.noLyrics.showAlbum",
          "title": "无歌词时同时显示专辑",
          "default_value": false
        },
        {
          "type": "switch",
          "key": "layout.noLyrics.hideWhenInstrumental",
          "title": "无歌词时隐藏歌词占位句",
          "summary": "只隐藏占位句（如「纯音乐，请欣赏」「暂无歌词」）；**曲名与作者仍然显示**。窗口、封面与频谱不受影响。",
          "default_value": false
        },
        {
          "type": "switch",
          "key": "layout.noLyrics.titleInTranslation",
          "title": "无歌词时在译文行显示曲名",
          "summary": "仅在当前曲目没有歌词时生效。开启后曲名会额外画在第二行（译文行的位置）。",
          "default_value": false
        },
        {
          "type": "list",
          "key": "main_lyric.color_mode",
          "title": "主歌词颜色来源",
          "entries": [
            "手动指定",
            "跟随封面取色"
          ],
          "entry_values": [
            "manual",
            "cover"
          ],
          "default_value": "manual"
        },
        {
          "type": "button",
          "title": "已唱歌词颜色",
          "summary": "打开取色器（色域板 / 色相条 / 明度条 / RGB / hex）。",
          "arrow_type": "none",
          "on_click": "dev.cdl.host.CdlPlugin.pickSungColor"
        },
        {
          "type": "button",
          "title": "未唱歌词颜色",
          "summary": "打开取色器（色域板 / 色相条 / 明度条 / RGB / hex）。",
          "arrow_type": "none",
          "on_click": "dev.cdl.host.CdlPlugin.pickUnsungColor"
        },
        {
          "type": "button",
          "title": "译文歌词颜色",
          "summary": "打开取色器（色域板 / 色相条 / 明度条 / RGB / hex）。",
          "arrow_type": "none",
          "on_click": "dev.cdl.host.CdlPlugin.pickTranslationColor"
        },
        {
          "type": "list",
          "key": "main_lyric.translation.color_mode",
          "title": "副歌词颜色来源",
          "entries": [
            "手动指定",
            "跟随封面取色"
          ],
          "entry_values": [
            "manual",
            "cover"
          ],
          "default_value": "manual"
        },
        {
          "type": "switch",
          "key": "main_lyric.outline.enabled",
          "title": "主歌词描边",
          "default_value": false
        },
        {
          "type": "seekbar",
          "key": "main_lyric.outline.width_tenth_px",
          "title": "主歌词描边宽度（0.1 像素）",
          "summary": "仅在开启描边时生效。10 = 1.0 像素（描边在字形外侧的可见厚度约为其一半）。",
          "default_value": 10,
          "min": 0,
          "max": 40
        },
        {
          "type": "button",
          "title": "主歌词描边色",
          "summary": "打开取色器（色域板 / 色相条 / 明度条 / RGB / hex）。",
          "arrow_type": "none",
          "on_click": "dev.cdl.host.CdlPlugin.pickMainOutlineColor"
        },
        {
          "type": "switch",
          "key": "main_lyric.outline.follow_font_weight",
          "title": "描边粗细跟随字体粗细",
          "summary": "开启后，字体变粗/变细会按下面的比例带动描边宽度。",
          "default_value": false
